# Copia este archivo como .env y complétalo. El .env NUNCA se sube a GitHub.

PORT=3000

# Endpoint de RDS (consola AWS > RDS > tu base > Conectividad y seguridad)
# postgres://USUARIO:CONTRASEÑA@ENDPOINT:5432/medida
DATABASE_URL=postgres://medida_admin:CAMBIAR@medida-db.xxxxxxxx.us-east-1.rds.amazonaws.com:5432/medida
# RDS exige SSL. Pon false solo si usas un PostgreSQL local sin SSL.
PGSSL=true
# Opcional: ruta al certificado CA de RDS (global-bundle.pem) para verificar el servidor
PGSSL_CA=

# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=8000
# Tope diario propio de llamadas a Gemini (después usa las reglas)
GEMINI_DAILY_CAP=500

# Guardar eventos anónimos de uso (true/false)
LOG_EVENTS=true
