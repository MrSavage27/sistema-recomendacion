{
  "name": "medida",
  "version": "0.1.0",
  "description": "Medida — asesor de compra de laptops (INNOVA, PUCP)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "dev:pruebas": "node --watch --env-file-if-exists=.env scripts/dev-pruebas.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:check": "node --env-file-if-exists=.env scripts/check-db.js",
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
    "@vercel/functions": "^3.11.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "pg": "^8.23.1"
  }
}
